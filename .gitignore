# ── Build y distribución ──────────────────────────────────────────────────────
dist/exe/           # exe compilado — se sube a GitHub Releases, no al repo
dist/release/       # agentes firmados — se suben a GitHub Releases, no al repo
build/work/
*.spec
*.exe
*.new
*.bak

# ── tools/setup_db build artifacts ───────────────────────────────────────────
tools/dist/
!tools/dist/atana_setup.exe
!tools/dist/atana_otp.exe
tools/_build_work/
tools/_build_spec/

# ── ffmpeg — binarios para empaquetar con PyInstaller (cubiertos por *.exe) ──
# Descargar de https://ffmpeg.org/download.html → copiar a tools/ffmpeg/
# No se versionan por tamaño (~70MB). El .exe del cliente los lleva empaquetados.
# tools/ffmpeg/ffmpeg.exe   ← ya ignorado por *.exe arriba
# tools/ffmpeg/ffprobe.exe  ← ya ignorado por *.exe arriba
# tools/ffmpeg/.gitkeep     ← versionado (marca que la carpeta existe)

# ── Firmas de agentes (generadas por build/sign.py) ───────────────────────────
agents/*.sig

# ── Tests y cobertura ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

